# Upstash Redis REST credentials for direct Upstash configuration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Marketplace compatibility names. Use either this pair or the pair above.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Private random value used to HMAC client addresses before rate limiting.
RATE_LIMIT_SALT=

# Resend (https://resend.com) API key used to send booking inquiry emails.
RESEND_API_KEY=

# Inbox that booking inquiries are delivered to.
BOOKING_TO_EMAIL=hello@djknwldg.com

# Must be an address on a domain verified in Resend.
BOOKING_FROM_EMAIL="KNWLDG Bookings <bookings@djknwldg.com>"

# Public browser key for venue, city, and address suggestions. Restrict this
# key to the site's HTTP referrers and Geoapify's Geocoding API.
NEXT_PUBLIC_GEOAPIFY_API_KEY=
