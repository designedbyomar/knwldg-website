# Resend (https://resend.com) API key used to send booking inquiry emails.
RESEND_API_KEY=

# Inbox that booking inquiries are delivered to.
BOOKING_TO_EMAIL=hello@djknwldg.com

# Must be an address on a domain verified in Resend. The default below
# (onboarding@resend.dev) only works for testing, not production sends.
BOOKING_FROM_EMAIL="KNWLDG Bookings <onboarding@resend.dev>"
